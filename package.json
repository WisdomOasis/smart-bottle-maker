{
  "name": "smart-bottle-maker",
  "version": "1.0.2",
  "description": "Maxi-Cosi Smart Bottle Maker Ray panel",
  "main": "index.js",
  "private": true,
  "author": "Tuya.inc",
  "license": "MIT",
  "scripts": {
    "start": "ray start --target tuya",
    "build": "ray build --target tuya",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "i18n:export": "node scripts/sync-i18n-export.js",
    "i18n:watch": "node scripts/sync-i18n-export.js --watch",
    "milk-db:sync": "node scripts/sync-milk-database.js"
  },
  "dependencies": {
    "@ray-js/components-ty-cell": "^0.0.19",
    "@ray-js/panel-sdk": "^1.10.0",
    "@ray-js/ray": "^1.5.44",
    "@ray-js/ray-error-catch": "^0.0.23",
    "@ray-js/smart-ui": "^2.0.0",
    "@ray-js/svg": "^0.2.0",
    "@reduxjs/toolkit": "^1.9.3",
    "@zxing/library": "0.21.3",
    "clsx": "^1.2.1",
    "dayjs": "^1.11.13",
    "jpeg-js": "^0.4.4",
    "react-redux": "^7.2.1",
    "redux-logger": "^3.0.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^7.2.1",
    "@commitlint/config-conventional": "^9.0.1",
    "@ray-js/cli": "^1.5.44",
    "@types/jpeg-js": "^0.3.7",
    "@types/lodash-es": "^4.17.6",
    "@types/react": "^17.0.24",
    "@types/react-dom": "^17.0.9",
    "core-js": "^3.29.1",
    "eslint-config-tuya-panel": "^0.4.1",
    "husky": "^1.2.0",
    "lint-staged": "^10.2.11",
    "typescript": "^4.4.3"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS --config commitlint.config.js",
      "pre-commit": "node scripts/sync-i18n-export.js --staged-only && lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "git add"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write",
      "git add"
    ]
  }
}
